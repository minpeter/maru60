(pcb "/workspace/shared/maru60-placement-lab/unit-counterexamples/via_touching/input.dsn"
  (parser
    (string_quote ")
    (space_in_quoted_tokens on)
    (host_cad "KiCad's Pcbnew")
    (host_version "9.0.2+dfsg-1")
  )
  (resolution um 10)
  (unit um)
  (structure
    (layer F.Cu
      (type signal)
      (property
        (index 0)
      )
    )
    (layer In1.Cu
      (type signal)
      (property
        (index 1)
      )
    )
    (layer In2.Cu
      (type signal)
      (property
        (index 2)
      )
    )
    (layer B.Cu
      (type signal)
      (property
        (index 3)
      )
    )
    (boundary
      (path pcb 0  20000 -20000  0 -20000  0 0  20000 0  20000 -20000)
    )
    (via "Via[0-3]_600:300_um" "Via[0-3]_600:250_um")
    (rule
      (width 200)
      (clearance 150)
      (clearance 37.5 (type smd_smd))
    )
  )
  (placement
    (component ""
      (place J2 15000.000000 -10000.000000 front 0.000000 (PN unit_test))
      (place J1 5000.000000 -10000.000000 front 0.000000 (PN unit_test))
    )
  )
  (library
    (image ""
      (pin Rect[T]Pad_800.000000x800.000000_um 1 0 0)
    )
    (padstack Rect[T]Pad_800.000000x800.000000_um
      (shape (rect F.Cu -400 -400 400 400))
      (attach off)
    )
    (padstack "Via[0-3]_600:300_um"
      (shape (circle F.Cu 600))
      (shape (circle In1.Cu 600))
      (shape (circle In2.Cu 600))
      (shape (circle B.Cu 600))
      (attach off)
    )
    (padstack "Via[0-3]_600:250_um"
      (shape (circle F.Cu 600))
      (shape (circle In1.Cu 600))
      (shape (circle In2.Cu 600))
      (shape (circle B.Cu 600))
      (attach off)
    )
  )
  (network
    (net GND
      (pins J2-1 J1-1)
    )
    (class kicad_default GND
      (circuit
        (use_via "Via[0-3]_600:300_um")
      )
      (rule
        (width 200)
        (clearance 150)
      )
    )
  )
  (wiring
    (wire (path F.Cu 200  10600 -10000  15000 -10000)(net GND)(type fix))
    (wire (path F.Cu 200  10000 -10000  10600 -10000)(net GND)(type fix))
    (wire (path F.Cu 200  5000 -10000  10000 -10000)(net GND)(type fix))
    (via "Via[0-3]_600:250_um"  10000 -10000 (net GND)(type fix))
    (via "Via[0-3]_600:250_um"  10600 -10000 (net GND)(type fix))
  )
)
