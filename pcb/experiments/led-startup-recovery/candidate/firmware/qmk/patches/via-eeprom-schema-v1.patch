+// Optional stable EEPROM schema identity; keep the legacy date default for
+// keyboards that have not opted in. This does not move any EEPROM storage.
+static void via_eeprom_get_magic(uint8_t *magic0, uint8_t *magic1, uint8_t *magic2) {
+#ifdef VIA_EEPROM_SCHEMA_ID
+#    if VIA_EEPROM_SCHEMA_ID <= 0 || VIA_EEPROM_SCHEMA_ID >= 0xFFFFFFUL
+#        error VIA_EEPROM_SCHEMA_ID must be a nonzero 24-bit value other than 0xFFFFFF
+#    endif
+    *magic0 = (VIA_EEPROM_SCHEMA_ID >> 16) & 0xFF;
+    *magic1 = (VIA_EEPROM_SCHEMA_ID >> 8) & 0xFF;
+    *magic2 = VIA_EEPROM_SCHEMA_ID & 0xFF;
+#else
+    const char *p = QMK_BUILDDATE;
+    *magic0 = ((p[2] & 0x0F) << 4) | (p[3] & 0x0F);
+    *magic1 = ((p[5] & 0x0F) << 4) | (p[6] & 0x0F);
+    *magic2 = ((p[8] & 0x0F) << 4) | (p[9] & 0x0F);
+#endif
+}
 
