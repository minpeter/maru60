+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+// Optional VIA_EEPROM_SCHEMA_ID is a stable 24-bit storage/meaning version.
+// 0 and 0xFFFFFF are reserved. No EEPROM offsets or sizes are changed.
+// Without an ID, VIA retains its existing date-derived magic behavior.
+#define QMK_VIA_EEPROM_SCHEMA_API_VERSION 1
