(version 1)
# JLCPCB manufacturing limits for maru60 (4 layers, 1 oz outer / 0.5 oz inner,
# 1.6 mm, routed outline), as published 2026-11-11 on
#   https://jlcpcb.com/capabilities/pcb-capabilities
# Each rule name carries the JLC table row it encodes.
#
# KiCad evaluates only the highest-priority (= last in file) matching rule per
# constraint type, so the minimum and the recommended tier of one constraint
# cannot both fire in one run, and one run with the whole file takes about an
# hour on this board. pcb/tools/run_dfm_jlcpcb_drc.py therefore runs every
# rule alone on a scratch copy of the project (a few seconds each):
#   SECTION 1  JLC absolute minimum      -> severity error
#   SECTION 2  JLC recommended/preferred -> severity warning
#
# Not expressible as KiCad rules (checked geometrically by the script instead):
# solder-mask dam, paste area ratio, via-in-pad, silkscreen stroke width of
# graphics, slot length/width ratio, assembly spacing, copper slivers.

# ---------------------------------------------------------------- SECTION 1
(rule "jlc_min_track_width_0.09"
	(severity error)
	(constraint track_width (min 0.09mm)))

(rule "jlc_min_copper_clearance_0.09"
	(severity error)
	(constraint clearance (min 0.09mm)))

(rule "jlc_min_pad_to_track_0.10"
	(severity error)
	(condition "(A.Type == 'Pad' && B.Type != 'Pad') || (B.Type == 'Pad' && A.Type != 'Pad')")
	(constraint clearance (min 0.10mm)))

(rule "jlc_min_smd_pad_to_pad_0.15"
	(severity error)
	(condition "A.Type == 'Pad' && B.Type == 'Pad'")
	(constraint clearance (min 0.15mm)))

(rule "jlc_min_neck_0.09"
	(severity error)
	(constraint connection_width (min 0.09mm)))

(rule "jlc_min_via_diameter_0.25"
	(severity error)
	(constraint via_diameter (min 0.25mm)))

(rule "jlc_min_drill_0.15_max_6.3"
	(severity error)
	(constraint hole_size (min 0.15mm) (max 6.3mm)))

(rule "jlc_min_npth_0.50"
	(severity error)
	(condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical'")
	(constraint hole_size (min 0.50mm) (max 6.3mm)))

(rule "jlc_min_plated_slot_width_0.35"
	(severity error)
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && A.Hole_Size_X != A.Hole_Size_Y")
	(constraint hole_size (min 0.35mm) (max 6.3mm)))

(rule "jlc_min_nonplated_slot_width_1.0"
	(severity error)
	(condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical' && A.Hole_Size_X != A.Hole_Size_Y")
	(constraint hole_size (min 1.0mm) (max 6.3mm)))

(rule "jlc_min_via_annular_0.05"
	(severity error)
	(condition "A.Type == 'Via'")
	(constraint annular_width (min 0.05mm)))

(rule "jlc_min_pth_annular_0.15"
	(severity error)
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
	(constraint annular_width (min 0.15mm)))

# Hole wall to copper of another net. Order matters: the PTH rule is last so a
# pair that involves a plated component hole gets 0.28 mm.
(rule "jlc_min_via_hole_to_copper_0.20"
	(severity error)
	(condition "A.Type == 'Via' || B.Type == 'Via'")
	(constraint hole_clearance (min 0.20mm)))

(rule "jlc_min_npth_to_copper_0.20"
	(severity error)
	(condition "A.Pad_Type == 'NPTH, mechanical' || B.Pad_Type == 'NPTH, mechanical'")
	(constraint hole_clearance (min 0.20mm)))

(rule "jlc_min_pth_hole_to_copper_0.28"
	(severity error)
	(condition "A.Pad_Type == 'Through-hole' || B.Pad_Type == 'Through-hole'")
	(constraint hole_clearance (min 0.28mm)))

(rule "jlc_min_pth_hole_to_inner_copper_0.30"
	(severity error)
	(layer inner)
	(condition "A.Pad_Type == 'Through-hole' || B.Pad_Type == 'Through-hole'")
	(constraint hole_clearance (min 0.30mm)))

(rule "jlc_min_via_hole_to_hole_0.20"
	(severity error)
	(constraint hole_to_hole (min 0.20mm)))

(rule "jlc_min_pad_hole_to_hole_0.45"
	(severity error)
	(condition "A.Type == 'Pad' || B.Type == 'Pad'")
	(constraint hole_to_hole (min 0.45mm)))

(rule "jlc_min_copper_to_routed_edge_0.20"
	(severity error)
	(constraint edge_clearance (min 0.20mm)))

(rule "jlc_min_silk_text_height_1.0"
	(severity error)
	(layer "?.Silkscreen")
	(constraint text_height (min 1.0mm)))

(rule "jlc_min_silk_text_stroke_0.15"
	(severity error)
	(layer "?.Silkscreen")
	(constraint text_thickness (min 0.15mm)))

(rule "jlc_min_pad_to_silk_0.15"
	(severity error)
	(layer outer)
	(condition "A.Type == 'Pad' || B.Type == 'Pad'")
	(constraint silk_clearance (min 0.15mm)))

# ---------------------------------------------------------------- SECTION 2
(rule "jlc_rec_via_hole_0.20"
	(severity warning)
	(condition "A.Type == 'Via'")
	(constraint hole_size (min 0.20mm) (max 6.3mm)))

(rule "jlc_rec_pth_hole_0.50"
	(severity warning)
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && A.Hole_Size_X == A.Hole_Size_Y && !(A.memberOfFootprint('U1') && A.Pad_Number == '61')")
	(constraint hole_size (min 0.50mm) (max 6.3mm)))

(rule "jlc_rec_plated_slot_width_0.50"
	(severity warning)
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && A.Hole_Size_X != A.Hole_Size_Y")
	(constraint hole_size (min 0.50mm) (max 6.3mm)))

(rule "jlc_rec_via_no_surcharge_diameter_0.45"
	(severity warning)
	(constraint via_diameter (min 0.45mm)))

(rule "jlc_rec_via_annular_0.075"
	(severity warning)
	(condition "A.Type == 'Via'")
	(constraint annular_width (min 0.075mm)))

(rule "jlc_rec_pth_annular_0.20"
	(severity warning)
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && !(A.memberOfFootprint('U1') && A.Pad_Number == '61')")
	(constraint annular_width (min 0.20mm)))

(rule "jlc_rec_pth_hole_to_copper_0.35"
	(severity warning)
	(condition "A.Pad_Type == 'Through-hole' || B.Pad_Type == 'Through-hole'")
	(constraint hole_clearance (min 0.35mm)))

(rule "jlc_rec_copper_to_routed_edge_0.30"
	(severity warning)
	(constraint edge_clearance (min 0.30mm)))

# U1 pad 61 includes nine plated thermal barrels, not component lead holes.
# Keep their geometry independently checked by check_dfm_jlcpcb.py.
(rule "jlc_rec_u1_thermal_hole_0.20"
	(severity warning)
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && A.memberOfFootprint('U1') && A.Pad_Number == '61'")
	(constraint hole_size (min 0.20mm) (max 0.30mm)))

(rule "jlc_rec_u1_thermal_annular_0.075"
	(severity warning)
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && A.memberOfFootprint('U1') && A.Pad_Number == '61'")
	(constraint annular_width (min 0.075mm)))
