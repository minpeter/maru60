  "findings": [
    {
      "id": "SIM-01",
      "severity": "closed-by-simulation",
      "title": "eFuse dV/dt ramp is 25 ms and capacitor-only inrush is ~1.07 mA effective",
      "detail": "At C124=10 nF, SR=0.2 V/ms, Cprot=5.336 uF effective, the ramp reaches 5 V at 24.98 ms; the capacitor current is 1.067 mA and the stored energy is 66.7 uJ. A 0.3 A equivalent load peaks at 301.1 mA, below the 425 mA minimum ILIM."
    },
    {
      "id": "SIM-02",
      "severity": "closed-by-simulation",
      "title": "4 V rail startup is monotonic under the stated behavioral loop",
      "detail": "The coupled eFuse+buck simulation gives 4 V 90% at 32.11 ms and 99% at 33.42 ms at 0.1 A, with a largest drop from running max of 1.90 mV. At 0.3 A the 90% time is 32.11 ms. Conditional on the synthetic loop and 29.7 uF effective output capacitance; not a stability result."
    },
    {
      "id": "SIM-03",
      "severity": "review-flag",
      "title": "0.76 mA/channel is at the current-limit edge and can latch off at startup",
      "detail": "76x3x0.76 mA = 173.28 mA vs 173.657 mA minimum ILIM: 0.377 mA (0.22%) margin. With the LED load present at enable, the simulation latches at 8.13 ms; with the load sequenced after the rail is up, it does not latch and the rail is 3.9853 V. Sequence the LED load after the rail is up, or cap at <=0.70 mA/channel."
    },
    {
      "id": "SIM-04",
      "severity": "review-flag",
      "title": "Full white 1.14 A is 4.87-6.56x the LED limiter and latches off",
      "detail": "The TPS2553-1 limits at 173.7 mA, the rail collapses to 0.453 V, and the 7.5 ms deglitch latches the switch off at 7.60 ms. The electrical dissipation in U7 is 0.616 W (not a thermal result). Full white is not supported by this power tree."
    },
